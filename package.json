{
  "name": "virtual-printer",
  "version": "1.0.19",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "description": "A Node.js module that makes Virtual IPP Printer",
  "author": {
    "name": "Hyeonseung Kang",
    "email": "hyeonseung.kang.dev@gmail.com",
    "url": "https://github.com/hyeonseungkang"
  },
  "homepage": "https://github.com/hyeonseungkang/virtual-printer",
  "repository": {
    "url": "https://github.com/hyeonseungkang/virtual-printer.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/hyeonseungkang/virtual-printer/issues"
  },
  "keywords": [
    "printer",
    "virtual",
    "ipp",
    "http",
    "server"
  ],
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/bin.ts",
    "build": "tsc --build",
    "prestart": "pnpm install && pnpm run build",
    "start": "node dist/bin.js",
    "lint": "eslint src/ test/",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@homebridge/ciao": "1.3.11",
    "fastify": "^5.12.0",
    "ipp": "^2.0.1",
    "tiny-typed-emitter": "^2.1.0"
  },
  "devDependencies": {
    "@types/ipp": "^2.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.8.2",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^2.7.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
